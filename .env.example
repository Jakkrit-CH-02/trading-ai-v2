# Copy to .env — never commit real values.
POSTGRES_USER=softtrade
POSTGRES_PASSWORD=softtrade
JWT_SECRET=change-me
# Binance Testnet/Demo only until Gate B (see CLAUDE.md). Leave empty in repo.
# demo = Binance Demo Trading (demo-api.binance.com); testnet = testnet.binance.vision
BINANCE_TRADING_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Host port for the API (change if 8000 is taken)
API_PORT=8000
# Host ports for postgres/redis (change if taken)
POSTGRES_PORT=5432
REDIS_PORT=6379
