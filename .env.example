# Mode + safety gate
BOT_MODE=paper
LIVE_TRADING_ENABLED=false

# Binance testnet (sign up: https://testnet.binance.vision)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Backend
BACKEND_PORT=8080

# Postgres (must match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradingbot
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
DATABASE_URL=postgres://bot:bot@localhost:5432/tradingbot?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Risk defaults (override config/config.dev.yaml)
BOT_RISK_MAX_POSITION_PCT=0.02
BOT_RISK_MAX_DAILY_DRAWDOWN_PCT=0.05
BOT_RISK_MAX_SLIPPAGE_BPS=30

# Frontend
VITE_API_BASE_URL=http://localhost:8080
