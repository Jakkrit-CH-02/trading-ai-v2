# Copy to .env — never commit real values.
POSTGRES_USER=softtrade
POSTGRES_PASSWORD=softtrade
JWT_SECRET=change-me
# Binance Testnet/Demo only until Gate B (see CLAUDE.md). Leave empty in repo.
# demo = Binance Demo Trading (demo-api.binance.com); testnet = testnet.binance.vision
BINANCE_TRADING_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Host port for the API (change if 8000 is taken)
API_PORT=8000
# Host port for the web UI
WEB_PORT=3005
# Host ports for postgres/redis (change if taken)
POSTGRES_PORT=5432
REDIS_PORT=6379

# Generate with: cd backend && uv run softtrade gen-master-key   (wraps per-record data keys; never commit the real one)
MASTER_KEY=
# JWT_SECRET must be >= 32 random characters outside dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI layer (Phase 6). Only the ai-worker container reads the key. Leave empty to run headlines-only.
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=20
