{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "gen:api": "(cd ../backend && uv run python -c \"import json; from app.main import app; print(json.dumps(app.openapi()))\") > openapi.json && openapi-typescript openapi.json -o src/lib/api-types.ts"
  },
